# Parental (block 20170; 20160 is voice). Copy to the deploy env file; secrets as files.
PARENTAL_HTTP_ADDR=0.0.0.0:20170
PARENTAL_GRPC_ADDR=0.0.0.0:20171
# Postgres, database "parental". Migrations apply at start-up.
PARENTAL_DATABASE_URL_FILE=/run/parental/database.url
# The account core: its gRPC (+1 of its block) and HTTP (whoami), and the
# credential this service presents there.
PARENTAL_CORE_ADDRESS=openpak-account:20001
PARENTAL_CORE_HTTP_URL=http://openpak-account:20000
PARENTAL_CORE_INTERNAL_KEY_FILE=/run/parental/core.key
# What the website presents on the HTTP surface (X-Internal-Key), >= 32 characters.
PARENTAL_INTERNAL_KEY_FILE=/run/parental/web.key
# One key per network adapter, "namespace=key" per line or comma separated (keys
# >= 32 characters). The key names the namespace: switch (nx-pctl), later wiiu, ...
PARENTAL_ADAPTER_KEYS_FILE=/run/parental/adapters.keys
# How long parental_changed events are kept (Go duration, >= 1h).
PARENTAL_EVENT_RETENTION=168h
